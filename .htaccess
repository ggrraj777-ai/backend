<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Hide a specific file
    <Files .env>
        Order allow,deny
        Deny from all
    </Files>
    
    # Redirect all requests to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ /public/$1 [L,QSA]
</IfModule>
